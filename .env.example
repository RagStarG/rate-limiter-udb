# Environment Configuration for Rate Limiter Backend
# Copy this file to .env to configure local settings

# Application Server
HOST=127.0.0.1
PORT=5000
DEBUG=True

# Storage Configuration
# If REDIS_URL is commented or unreachable, the system automatically falls back
# to the high-performance thread-safe InMemoryKVStore.
# REDIS_URL=redis://localhost:6379/0

# Rate Limiter Defaults
DEFAULT_LIMIT=10
DEFAULT_WINDOW_SECONDS=60
